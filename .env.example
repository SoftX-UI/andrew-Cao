# ==============================================================================
# Client-side (Public) Environment Variables (Pre-fixed with VITE_)
# Only add non-secret URLs and public anonymous keys here.
# ==============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ==============================================================================
# Server-side (Private) Secrets (Held strictly in /api/ Serverless functions)
# NEVER prefix these with VITE_ to prevent leaking into the browser bundle.
# ==============================================================================
GEMINI_API_KEY=
GOOGLE_MAPS_PLATFORM_KEY=
